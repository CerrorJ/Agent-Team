# bot 注册文件路径；默认读取 config/bots.json
BOTS_CONFIG=config/bots.json

# 飞书凭证变量名由 bots.json 中的 appIdEnv / appSecretEnv 决定
FEISHU_CEO_ASSISTANT_APP_ID=cli_xxx
FEISHU_CEO_ASSISTANT_APP_SECRET=xxx
FEISHU_PRODUCT_APP_ID=cli_xxx
FEISHU_PRODUCT_APP_SECRET=xxx
FEISHU_DEVELOPER_APP_ID=cli_xxx
FEISHU_DEVELOPER_APP_SECRET=xxx
FEISHU_REVIEWER_APP_ID=cli_xxx
FEISHU_REVIEWER_APP_SECRET=xxx
FEISHU_TESTER_APP_ID=cli_xxx
FEISHU_TESTER_APP_SECRET=xxx

# 测试话题群 chat_id（把 bot 拉进群后获取）
TEST_CHAT_ID=oc_xxx

# 你自己的 open_id（跑通 echo bot 后从日志 sender= 字段获取，审批/通知篇会用）
OWNER_OPEN_ID=ou_xxx

# AI 编程 CLI 执行任务的项目目录，默认是 Agent Team 当前目录
# 旧键 CLAUDE_WORKDIR 仍兼容，作为兜底
CLI_WORKDIR=

# Claude Code / Codex 的模型后端默认使用各自的用户级配置管理，也可使用 CC Switch 在不同模型服务间切换
# 任意 bot 均可在 config/bots.json 中通过 cliEnv 独立配置模型后端（未配置 cliEnv 的 bot 继续跟随全局/CC Switch）
# 以下变量以 CEO 助理为例（示例直连智谱）：bots.json 只引用变量名，密钥在此处保存
# 留空表示不启用该示例覆盖；如需为其他 bot（如开发/测试等）独立配置后端，可参照此模式在 bots.json 声明 cliEnv 并定义对应环境变量
CEO_ZHIPU_ANTHROPIC_BASE_URL=
CEO_ZHIPU_ANTHROPIC_AUTH_TOKEN=
CEO_ZHIPU_ANTHROPIC_MODEL=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_FABLE_MODEL=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=glm-5.3
CEO_ZHIPU_ANTHROPIC_DEFAULT_FABLE_MODEL_NAME=glm-5.3

CLAUDE_TIMEOUT_MS=7200000
CODEX_TIMEOUT_MS=7200000
# 也可以用一个变量统一配置两个 CLI
# CLI_TIMEOUT_MS=7200000

# 定时任务管理 API；token 留空时不校验
SCHEDULE_API_PORT=3101
SCHEDULE_API_TOKEN=

# 服务端日志巡检：运维群自定义机器人 webhook；留空时巡检不推送（demo-server 演示用）
PATROL_WEBHOOK_URL=
