{
  "name": "Agent-Team",
  "version": "1.0.0",
  "description": "Agent Team — 你的个人生产系统",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm start",
    "start": "tsx watch --include .env --include \"config/*.json\" src/index.ts",
    "start:once": "tsx src/index.ts",
    "build": "tsc",
    "agent-team": "tsx src/deploy-cli.ts",
    "demo:server": "pnpm --filter agent-team-demo-server start",
    "demo:traffic": "pnpm --filter agent-team-demo-server traffic",
    "probe:cli": "tsx src/probe-cli.ts",
    "probe:tool": "tsx src/probe-app-tool.ts",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test \"tests/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cac": "^6.7.14",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
