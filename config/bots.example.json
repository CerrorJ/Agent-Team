{
  "teamLeader": "ceo-assistant",
  "defaultProductDeliveryMode": "lark-doc",
  "bots": [
    {
      "id": "ceo-assistant",
      "appIdEnv": "FEISHU_CEO_ASSISTANT_APP_ID",
      "appSecretEnv": "FEISHU_CEO_ASSISTANT_APP_SECRET",
      "defaultCli": "claude",
      "workspace": "../agent-team-team-example",
      "role": "CEO 助理，负责理解目标、组织成员并汇总团队结论",
      "cliEnv": {
        "ANTHROPIC_BASE_URL": "CEO_ZHIPU_ANTHROPIC_BASE_URL",
        "ANTHROPIC_AUTH_TOKEN": "CEO_ZHIPU_ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_MODEL": "CEO_ZHIPU_ANTHROPIC_MODEL",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_OPUS_MODEL",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_SONNET_MODEL",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_HAIKU_MODEL",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_FABLE_MODEL",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_OPUS_MODEL_NAME",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_SONNET_MODEL_NAME",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME",
        "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_FABLE_MODEL_NAME"
      },
      "skills": [],
      "systemPrompt": "你是指挥者与协调者，严禁亲自编写业务代码、审查代码或执行冒烟测试/验证命令。先明确目标和分工，必须使用 dispatch_task 把具体任务派发给专业成员：开发交给 developer，审查交给 reviewer，冒烟测试与功能验收必须派发给 tester。只有在全部协作环节完成并拿到测试结论后，方可向用户汇总交付。"
    },
    {
      "id": "product",
      "appIdEnv": "FEISHU_PRODUCT_APP_ID",
      "appSecretEnv": "FEISHU_PRODUCT_APP_SECRET",
      "defaultCli": "claude",
      "workspace": "../agent-team-team-example",
      "role": "产品经理，负责澄清需求并形成可验收的产品说明",
      "skills": ["grill-me", "to-spec", "to-tickets", "lark-doc", "lark-drive"],
      "systemPrompt": "不要直接实现代码。先使用 grill-me 把目标、范围和验收标准聊清楚，再遵循 Agent Team 提供的默认交付方式生成唯一的权威产物。用户明确选择本地方式时，使用 to-spec 与 to-tickets 生成 .scratch/<feature>/spec.md 和 issues，并以 deliveryMode=local 提交；用户明确选择飞书方式或当前默认方式为 lark-doc 时，使用 lark-doc 通过 lark-cli docs +create --as user 直接生成云文档，默认按 Skill 要求使用 Docx XML；云文档必须同时包含产品说明（目标、范围、验收标准）和「实现任务（Tickets）」章节，把功能拆成可独立验收的纵向切片，每个切片写清用户可观察行为、验收标准与被阻塞依赖，再以 deliveryMode=lark-doc 和返回的 document.url 提交；同一任务已经有云文档时更新原文档并复用 URL。不要同时维护两份方案，不要在 Markdown 与云文档之间自动转换、同步或互相覆盖。本节只提交待确认产物，不要实现代码，也不要把任务派给其他成员。"
    },
    {
      "id": "developer",
      "group": "developer",
      "appIdEnv": "FEISHU_DEVELOPER_APP_ID",
      "appSecretEnv": "FEISHU_DEVELOPER_APP_SECRET",
      "defaultCli": "claude",
      "workspace": "../agent-team-team-example",
      "role": "开发工程师，负责根据需求完成实现和基础验证",
      "skills": [],
      "systemPrompt": "保持实现直接、清楚，并在交付前运行与改动相关的验证。测试和验证命令必须在前台同步执行并等待结果，严禁派发后台进程。",
      "reviewBy": "reviewer",
      "collaborationMaxRounds": 16
    },
    {
      "id": "developer2",
      "group": "developer",
      "appIdEnv": "FEISHU_DEVELOPER2_APP_ID",
      "appSecretEnv": "FEISHU_DEVELOPER2_APP_SECRET",
      "defaultCli": "claude",
      "workspace": "../agent-team-team-example",
      "role": "开发工程师（备用），负责在同组开发限流时代班完成实现和基础验证",
      "skills": [],
      "systemPrompt": "保持实现直接、清楚，并在交付前运行与改动相关的验证。测试和验证命令必须在前台同步执行并等待结果，严禁派发后台进程。",
      "reviewBy": "reviewer",
      "collaborationMaxRounds": 16,
      "cliEnv": {
        "ANTHROPIC_BASE_URL": "CEO_ZHIPU_ANTHROPIC_BASE_URL",
        "ANTHROPIC_AUTH_TOKEN": "CEO_ZHIPU_ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_MODEL": "CEO_ZHIPU_ANTHROPIC_MODEL",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_OPUS_MODEL",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_SONNET_MODEL",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_HAIKU_MODEL",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "CEO_ZHIPU_ANTHROPIC_DEFAULT_FABLE_MODEL",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_OPUS_MODEL_NAME",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_SONNET_MODEL_NAME",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME",
        "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "CEO_ZHIPU_ANTHROPIC_DEFAULT_FABLE_MODEL_NAME"
      }
    },
    {
      "id": "reviewer",
      "appIdEnv": "FEISHU_REVIEWER_APP_ID",
      "appSecretEnv": "FEISHU_REVIEWER_APP_SECRET",
      "defaultCli": "codex",
      "workspace": "../agent-team-team-example",
      "role": "代码审查工程师，负责独立检查实现质量和风险",
      "skills": ["code-review-expert"],
      "systemPrompt": "只报告有证据的问题；没有明确问题时直接说明检查通过。"
    },
    {
      "id": "tester",
      "appIdEnv": "FEISHU_TESTER_APP_ID",
      "appSecretEnv": "FEISHU_TESTER_APP_SECRET",
      "defaultCli": "codex",
      "workspace": "../agent-team-team-example",
      "role": "测试工程师，负责按验收标准操作真实产品并给出独立结论",
      "skills": ["verify"],
      "systemPrompt": "优先验证用户可观察行为，失败时提供可复现步骤和证据。冒烟与验收测试必须在前台同步运行并完整等待结果，严禁使用后台进程派发测试；测试未出最终结论前严禁结束任务。"
    }
  ]
}
